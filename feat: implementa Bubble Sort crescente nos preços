#include <stdio.h>
#include <string.h>

#define TAMANHO 10

void exibir(const char nomes[][20], const float precos[], int n) {
    for (int i = 0; i < n; i++) {
        printf(" %2d. %-18s R$ %7.2f\n", i + 1, nomes[i], precos[i]);
    }
}

void bubbleSort(char nomes[][20], float precos[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int trocou = 0;

        for (int j = 0; j < n - i - 1; j++) {
            if (precos[j] > precos[j + 1]) {
                float tempPreco = precos[j];
                precos[j] = precos[j + 1];
                precos[j + 1] = tempPreco;

                char tempNome[20];
                strcpy(tempNome, nomes[j]);
                strcpy(nomes[j], nomes[j + 1]);
                strcpy(nomes[j + 1], tempNome);

                trocou = 1;
            }
        }

        if (!trocou) {
            break;
        }
    }
}

int main(void) {
    char nomes[TAMANHO][20] = {
        "Arroz 5kg", "Feijao 1kg", "Cafe 500g", "Leite 1L", "Acucar 1kg",
        "Oleo de soja", "Macarrao 500g", "Sabao em po", "Biscoito", "Farinha 1kg"
    };

    float precos[TAMANHO] = {
        27.90f, 8.49f, 16.75f, 5.29f, 4.99f,
        7.89f, 4.29f, 18.50f, 3.99f, 5.49f
    };

    printf("--- ANTES da ordenacao ---\n");
    exibir(nomes, precos, TAMANHO);

    bubbleSort(nomes, precos, TAMANHO);

    printf("\n--- DEPOIS da ordenacao (menor para maior preco) ---\n");
    exibir(nomes, precos, TAMANHO);

    return 0;
}
